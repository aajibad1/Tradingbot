              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InvoiceRequest": {
        "properties": {
          "period": {
            "description": "Billing period, e.g. '2026-06'",
            "title": "Period",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          },
          "usage_total": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usage Total"
          }
        },
        "required": [
          "tenant_id",
          "period"
        ],
        "title": "InvoiceRequest",
        "type": "object"
      },
      "PlanCreate": {
        "properties": {
          "base_fee": {
            "minimum": 0.0,
            "title": "Base Fee",
            "type": "number"
          },
          "currency": {
            "default": "USD",
            "title": "Currency",
            "type": "string"
          },
          "included_units": {
            "minimum": 0.0,
            "title": "Included Units",
            "type": "integer"
          },
          "per_unit_rate": {
            "minimum": 0.0,
            "title": "Per Unit Rate",
            "type": "number"
          },
          "plan_id": {
            "title": "Plan Id",
            "type": "string"
          }
        },
        "required": [
          "plan_id",
          "base_fee",
          "included_units",
          "per_unit_rate"
        ],
        "title": "PlanCreate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
