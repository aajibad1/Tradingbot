{
  "components": {
    "schemas": {
      "Adjust": {
        "properties": {
          "amount": {
            "description": "Positive = credit, negative = debit",
            "title": "Amount",
            "type": "number"
          },
          "reason": {
            "default": "",
            "description": "Audit reason, e.g. 'funding ord_123 completed'",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "amount"
        ],
        "title": "Adjust",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WalletCreate": {
        "properties": {
          "asset": {
            "description": "Asset/currency held, e.g. USDC, NGN",
            "title": "Asset",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "asset"
        ],
        "title": "WalletCreate",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "wallet-service",
    "version": "0.1.0"
  },
