# Base URL of the core-api service.
NEXT_PUBLIC_API_BASE=http://localhost:8080
# Local dev auth: core-api with AUTH_PROVIDER unset accepts a "local:<uid>[:<email>]"
# bearer. The dev sign-in screen builds this; Clerk replaces it in prod.
# status-service URL — when set, the app shows a status/incident banner.
NEXT_PUBLIC_STATUS_URL=http://localhost:8095
